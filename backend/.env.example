# ==============================================================================
# AI Financial Decision Support System — Environment Configuration
# ==============================================================================

# Database Configuration (Optional: SQLite local fallback used if unset)
# DATABASE_URL=sqlite:///./data/financial_portfolio.db

# JWT Authentication Secret
JWT_SECRET_KEY=financial_decision_support_super_secret_jwt_key_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Security & CORS Allowed Origins (Comma-separated URLs)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==============================================================================
# LLM Provider Configuration (Choose one option below)
# ==============================================================================

# OPTION 1: BUILT-IN MOCK (Default: 100% Free, No API key or internet needed!)
LLM_PROVIDER=mock

# OPTION 2: GROQ CLOUD (High-speed, Free tier available!)
# 1. Sign up free at: https://console.groq.com
# 2. Generate a key at: https://console.groq.com/keys
# 3. Uncomment these lines:
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_your_groq_api_key_here
# LLM_MODEL=openai/gpt-oss-120b
# LLM_API_BASE=https://api.groq.com/openai/v1

# Financial News Ingestion Mode (false = live RSS feeds, true = offline mock)
NEWS_MOCK_MODE=false

# OPTION 3: GOOGLE GEMINI (100% Free via Google AI Studio!)
# 1. Get your free key at: https://aistudio.google.com/app/apikey
# 2. Uncomment these lines:
# LLM_PROVIDER=openai
# LLM_API_KEY=your_gemini_api_key_here
# LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-1.5-flash

# OPTION 4: OPENAI
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-proj-your-openai-api-key
# LLM_MODEL=gpt-4o-mini
